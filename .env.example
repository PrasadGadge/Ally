# ==================================================
# Vivie — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git — only .env.example
# ==================================================

# ── REQUIRED — STT will not work without this ──────
# Get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# BRAIN Tier 0 - Fast NVIDIA chat
# Get key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_build_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TIMEOUT_SEC=25

# BRAIN Tier 1 - Advanced tasks through OpenRouter
# Get key at: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-pro
OPENROUTER_TIMEOUT_SEC=90

# ── OPTIONAL — Vision only (Vibrain / image understanding) ─
# Get free key at: https://aistudio.google.com
GEMINI_API_KEY=

# ── REQUIRED — Weather features ─────────────────────
# Get free key at: https://www.weatherapi.com
WEATHER_API_KEY=your_weatherapi_key_here

# ── OPTIONAL — Cloud memory (mem0) ──────────────────
# Get key at: https://mem0.ai
# Leave empty to use local memory only
MEM0_API_KEY=

# ── OPTIONAL — Web Search with Citations ───────────────
# Get key at: https://tavily.com
# Used for research with source tracking
TAVILY_API_KEY=your_tavily_api_key_here

# ── OPTIONAL — Fine-tune Vivie behaviour ─────────────
# Interaction mode: "chat" (text-only) or "voice" (text + audio)
# Default: chat (text-only, no microphone, no TTS)
VIVIE_MODE=chat

# Seconds to ignore STT input after Vivie finishes speaking (prevents feedback loop)
VIVIE_POST_SPEAK_COOLDOWN=1.5

# Max seconds to wait for memory retrieval before skipping
VIVIE_MEMORY_TIMEOUT=3.0

# STT silence gap before cutting recording (seconds)
VIVIE_STT_SILENCE_SEC=1.2

# Maximum recording length per utterance (seconds)
VIVIE_STT_MAX_RECORD_SEC=12.0

# Groq STT model — whisper-large-v3-turbo is fastest + accurate
VIVIE_STT_MODEL=whisper-large-v3-turbo

# FFmpeg path for TTS streaming (optional, only if not in system PATH)
# Example on Windows: C:\path\to\ffmpeg.exe
# Example on Linux/Mac: /usr/bin/ffmpeg
# Leave empty to use system PATH discovery
FFMPEG_PATH=

# ══════════════════════════════════════════════════
# MCP INTEGRATIONS
# ══════════════════════════════════════════════════

# ── Google (Gmail + Calendar) ────────────────────
# Step 1: console.cloud.google.com → New Project
# Step 2: Enable Gmail API + Google Calendar API
# Step 3: Credentials → Create OAuth 2.0 Client ID → Desktop App
# Step 4: Copy client_id and client_secret below
# Step 5: Run: python setup_mcp.py
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── GitHub ───────────────────────────────────────
# github.com/settings/tokens → Generate new classic token
# Scopes: repo, issues, read:user
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_USERNAME=your_github_username
